{
  "rules": {
    ".read": false,
    ".write": false,
    "votes": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'chandroid@humanoid-mbti.firebaseapp.com'",
      "$id": {
        ".write": "$id.length <= 40 && (newData.exists() || (auth != null && auth.token.email === 'chandroid@humanoid-mbti.firebaseapp.com'))",
        ".validate": "newData.isString() && newData.val().matches(/^[EI][SN][TF][JP]$/)"
      }
    }
  }
}
